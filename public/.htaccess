# Apache, because the site is served from Hostinger shared hosting.
#
# The app is one HTML file plus a client-side router, so a deep link like
# /little_mind_gym/puzzle/river-crossing is a path Apache has no file for. Without
# the rewrite below it answers 404 and a child who bookmarked a puzzle gets an
# error page. Anything that IS a real file — the JS, the CSS, mark.svg — is
# served as itself; everything else is handed to index.html to route.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /little_mind_gym/

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . /little_mind_gym/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite stamps a content hash into every asset filename, so those URLs can
  # never mean two different things and may be cached hard. index.html carries
  # the pointers to them and must not be, or a deploy goes unnoticed.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
